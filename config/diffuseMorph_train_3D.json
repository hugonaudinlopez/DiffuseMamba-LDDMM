{
    "name": "DiffuseMorph_3D",
    "phase": "train",
    "gpu_ids": [
        0
    ],
    "display_port": 8097,
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null //the deirectory of trained models
    },
    "datasets": {
        "centered": true,
        "train": {
            "name": "OASIS",
            "dataroot": "/path/to/OASIS/imagesTr/",
            "pairs_json": "/path/to/OASIS/OASIS_dataset.json",
            "train_max_index": 395,
            "batch_size": 1,
            "num_workers": 8,
            "use_shuffle": true
        }
    },
    "model": {
        "netDim": 3,
        "which_model_G": "ddpm",
        "finetune_norm": false,
        "unet": {
            "in_channel": 3,
            "out_channel": 1,
            "inner_channel": 8,
            "channel_multiplier": [
                1,
                2,
                4,
                4
            ],
            "attn_res": [
                10
            ],
            "res_blocks": 1,
            "dropout": 0 //.2
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": [80, 96, 112],
            "conditional": true
        },
        "field": {
            "in_channel": 2,
            "encoder_nc": [16,32,32,32,32],
            "decoder_nc": [32,32,32,8,8,3],
            "steps": 7
        },
        "lddmm": {"alpha": 0.1, "s": 3},
        "loss": {
            "ncc_kernel": 5,
            "w_smt": 0.01,
            "w_lddmm": 0.5,
            "w_jac": 100,
            "jac_eps": 0.5
        },
        "loss_lambda": 20
    },
    "train": {
        "n_epoch": 15,
        "val_freq": 50000000,
        "save_checkpoint_epoch": 10,
        "print_freq": 394,
        "optimizer": {"type": "adam", "lr": 2e-4, "betas": [0.5, 0.999]}
    }
}
